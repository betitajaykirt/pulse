# Copy this file to .env and fill in real values. Never commit .env.

DEBUG=True
SECRET_KEY=replace-with-a-long-random-string
# Optional comma-separated previous keys used during a rotation.
# SECRET_KEY_FALLBACKS=

# Render injects DATABASE_URL when a PostgreSQL database is linked.
DATABASE_URL=postgresql://user:password@host:5432/database
# Render sets this automatically for deployed web services.
# RENDER_EXTERNAL_HOSTNAME=your-service.onrender.com

OCR_API_URL=https://api.ocr.space/parse/image
OCR_API_KEY=
OCR_ENGINE=3

# Seed/wipe scripts refuse hosted databases. Leave this unset in production.
# ALLOW_PROD_COMMANDS=1
