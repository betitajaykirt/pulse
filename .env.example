# Copy this file to .env and fill in real values. Never commit .env.

DEBUG=true
SECRET_KEY=replace-with-a-long-random-string
# Optional comma-separated previous keys used during a rotation.
# SECRET_KEY_FALLBACKS=

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

OCR_API_URL=https://api.ocr.space/parse/image
OCR_API_KEY=

# Seed/wipe scripts refuse hosted databases. Leave this unset in production.
# ALLOW_PROD_COMMANDS=1
